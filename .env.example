# Ultron AI Assistant Configuration

# LLM model to use (e.g. gemini-2.5-flash, gpt-4o, etc.)
ULTRON_MODEL=gemini-2.5-flash

# Wake word to trigger voice listening (e.g. Jarvis, Ultron)
ULTRON_WAKE_WORD=ultron

# Log level for application diagnostics (DEBUG, INFO, WARNING, ERROR)
ULTRON_LOG_LEVEL=INFO
